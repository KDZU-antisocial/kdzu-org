---
const navItems = [
  { href: '/', text: 'Home' },
  { href: '/events/', text: 'Events' },
  { href: '/tracks-we-love/', text: 'Tracks We Love' },
  { href: '/about/', text: 'About KDZU' },
];

const projectLinks = [
  { href: '/mdc/', text: 'Activating the MDC Mission' },
  { href: '/basslines/', text: 'Basslines from the Broken Earth' },
  { href: '/all-is-not-lost/', text: 'All Is Not Lost' },
];

const shoutLinks = [
  { href: 'mailto:kdzu@kdzu.org', text: 'kdzu@kdzu.org', icon: 'email' },
  { href: 'https://instagram.com/kdzu_antisocial', text: '@kdzu_antisocial', icon: 'instagram' },
  { href: 'https://tldr.nettime.org/@KDZU', text: 'tldr.nettime.org/@KDZU', icon: 'mastodon' },
  { href: 'https://bsky.app/profile/kdzu.org', text: 'bsky.app/profile/kdzu.org', icon: 'bluesky' },
];

const hammerLinks = [
  { href: '/static/', text: "Static is the Signal: KDZU's Field Guide to Tactical Mythmaking" },
  { href: 'https://prowrestling.fandom.com/wiki/Kayfabe', text: 'Kayfabe', external: true },
  {
    href: 'https://archive.org/download/139brechtashortorganumforthetheatre/139-Brecht_A_Short_Organum_for_the_Theatre.pdf',
    text: "Brecht's Organum (pdf)",
    external: true,
  },
];
---

<nav class="top-nav">
  <button class="hamburger" aria-label="Toggle menu" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
  <div class="nav-links">
    <ul class="nav-primary">
      {navItems.map((item) => (
        <li>
          <a href={item.href}>{item.text}</a>
        </li>
      ))}
    </ul>

    <section class="nav-section nav-section--mobile" aria-label="Projects">
      <h2>Projects</h2>
      <ul>
        {projectLinks.map((item) => (
          <li>
            <a href={item.href}>{item.text}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="nav-section nav-section--mobile" aria-label="Give Us a Shout!">
      <h2>Give Us a Shout!</h2>
      <ul class="nav-shout-list">
        {shoutLinks.map((item) => (
          <li>
            {item.icon === 'email' && (
              <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6zm-2 0l-8 5-8-5h16zm0 12H4V8l8 5 8-5v10z" fill="#ffffff" />
              </svg>
            )}
            {item.icon === 'instagram' && (
              <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" fill="#ffffff" />
              </svg>
            )}
            {item.icon === 'mastodon' && (
              <svg class="nav-icon" width="16" height="16" xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" text-rendering="geometricPrecision" image-rendering="optimizeQuality" fill-rule="evenodd" clip-rule="evenodd" viewBox="0 0 480 511.475" aria-hidden="true">
                <path fill="#fff" fill-rule="nonzero" d="M478.065 113.237c-7.393-54.954-55.29-98.266-112.072-106.656C356.413 5.162 320.121 0 236.043 0h-.626c-84.099 0-102.141 5.162-111.72 6.581C68.498 14.738 18.089 53.653 5.859 109.26c-5.882 27.384-6.51 57.747-5.416 85.594C2 234.794 2.302 274.662 5.93 314.438a562.647 562.647 0 0013.09 78.437c11.625 47.653 58.686 87.311 104.793 103.494a281.07 281.07 0 00153.315 8.09 223.879 223.879 0 0016.578-4.533c12.368-3.929 26.855-8.323 37.507-16.043a1.198 1.198 0 00.486-.928v-38.544a1.12 1.12 0 00-.437-.879 1.134 1.134 0 00-.957-.215 424.764 424.764 0 01-99.49 11.626c-57.665 0-73.172-27.361-77.611-38.75a120.008 120.008 0 01-6.745-30.549 1.048 1.048 0 01.094-.51c.07-.161.178-.304.317-.415a1.094 1.094 0 01.982-.213 417.004 417.004 0 0097.865 11.624c7.927 0 15.834 0 23.761-.213 33.156-.928 68.105-2.625 100.722-8.997.816-.16 1.63-.301 2.327-.508 51.455-9.883 100.423-40.894 105.397-119.421.184-3.092.652-32.382.652-35.588.021-10.904 3.509-77.344-.511-118.166zm-82.796 61.744V311.51h-54.104V179.003c0-27.897-11.627-42.126-35.273-42.126-25.998 0-39.018 16.834-39.018 50.073v72.534h-53.776V186.95c0-33.239-13.045-50.073-39.04-50.073-23.507 0-35.249 14.229-35.249 42.126V311.51H84.73V174.981c0-27.896 7.121-50.059 21.366-66.488 14.693-16.388 33.969-24.805 57.893-24.805 27.692 0 48.618 10.648 62.569 31.919l13.464 22.597 13.485-22.597c13.95-21.271 34.876-31.919 62.52-31.919 23.903 0 43.177 8.417 57.919 24.805 14.231 16.413 21.337 38.576 21.323 66.488z" />
              </svg>
            )}
            {item.icon === 'bluesky' && (
              <svg class="nav-icon" width="16" height="16" xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" text-rendering="geometricPrecision" image-rendering="optimizeQuality" fill-rule="evenodd" clip-rule="evenodd" viewBox="0 0 511.999 452.266" aria-hidden="true">
                <path fill="#ffffff" fill-rule="nonzero" d="M110.985 30.442c58.695 44.217 121.837 133.856 145.013 181.961 23.176-48.105 86.322-137.744 145.016-181.961 42.361-31.897 110.985-56.584 110.985 21.96 0 15.681-8.962 131.776-14.223 150.628-18.272 65.516-84.873 82.228-144.112 72.116 103.55 17.68 129.889 76.238 73 134.8-108.04 111.223-155.288-27.905-167.385-63.554-3.489-10.262-2.991-10.498-6.561 0-12.098 35.649-59.342 174.777-167.382 63.554-56.89-58.562-30.551-117.12 72.999-134.8-59.239 10.112-125.84-6.6-144.112-72.116C8.962 184.178 0 68.083 0 52.402c0-78.544 68.633-53.857 110.985-21.96z" />
              </svg>
            )}
            <a href={item.href}>{item.text}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="nav-section nav-section--mobile" aria-label="Swinging the Hammer">
      <h2>Swinging the Hammer</h2>
      <ul>
        {hammerLinks.map((item) => (
          <li>
            <a
              href={item.href}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.text}
              {item.external && (
                <svg class="external-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M15 3h6v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M10 14L21 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</nav>

<style>
  .top-nav {
    margin-bottom: 0;
    margin-right: 2rem;
    display: flex;
    justify-content: flex-end;
  }

  .nav-primary {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 2rem;
  }

  .top-nav a {
    color: var(--color-bright-white);
    text-decoration: none;
    font-size: 1.25rem;
    transition: color 0.2s ease;
  }

  .top-nav a:hover {
    color: var(--color-bright-white);
    opacity: 0.8;
  }

  .nav-section {
    display: none;
  }

  .nav-section h2 {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-bright-white);
  }

  .nav-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-section a {
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 400;
  }

  .nav-shout-list li {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-icon {
    flex-shrink: 0;
  }

  .external-icon {
    display: inline;
    vertical-align: middle;
    margin-left: 0.25rem;
    margin-top: -0.15rem;
  }

  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1000;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-bright-white);
    margin: 6px 0;
    transition: all 0.3s ease;
  }

  @media (max-width: 768px) {
    .nav-primary {
      gap: 1rem;
    }

    .top-nav a {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .hamburger {
      display: block;
      position: absolute;
      top: 0.5rem;
      right: 1rem;
    }

    .hamburger.active span:nth-child(1) {
      transform: rotate(45deg) translate(6px, 6px);
    }

    .hamburger.active span:nth-child(2) {
      opacity: 0;
    }

    .hamburger.active span:nth-child(3) {
      transform: rotate(-45deg) translate(6px, -6px);
    }

    .nav-links {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: var(--color-dark-bg);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      gap: 1.5rem;
      padding: 4.5rem 1.5rem 2rem;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      z-index: 999;
    }

    .nav-links.active {
      transform: translateX(0);
    }

    .nav-primary {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .nav-links h2 {
      color: var(--color-bright-white);
      font-size: 1.25rem;
      margin-bottom: 0.5rem;
    }

    .nav-links a {
      color: var(--color-bright-blue);
      font-weight: 500;
    }

    .nav-links a:hover {
      color: var(--color-bright-blue);
      opacity: 1;
      text-decoration: underline;
    }

    .nav-primary a {
      font-size: 1.25rem;
    }

    .nav-section a {
      font-size: 1rem;
      font-weight: 500;
    }

    .nav-section--mobile {
      display: block;
      padding-top: 0.5rem;
      border-top: 1px solid var(--color-medium-gray);
    }

    .nav-section--mobile:first-of-type {
      margin-top: 0.5rem;
    }
  }
</style>

<script>
  const hamburger = document.querySelector('.hamburger');
  const navLinks = document.querySelector('.nav-links');
  const links = document.querySelectorAll('.nav-links a');

  hamburger?.addEventListener('click', () => {
    const isOpen = hamburger.classList.toggle('active');
    navLinks?.classList.toggle('active');
    hamburger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  links.forEach((link) => {
    link.addEventListener('click', () => {
      hamburger?.classList.remove('active');
      navLinks?.classList.remove('active');
      hamburger?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
